# Environment variables example for ChaiForms-Form-Builder-SaaS
# Generated: 2026-05-25
# Replace placeholder values before use.

# ---- API / server ----
# Port the API listens on (used by apps/api)
PORT=8000

# Node environment (default: development)
NODE_ENV=development

# Base URL for the server (used to generate OpenAPI baseUrl)
BASE_URL=http://localhost:8000

# ---- Database ----
# Connection string for your database
DATABASE_URL=postgresql://user:password@localhost:5432/dbname

# ---- Logger ----
# One of: error, info, debug
LOGGER_LEVEL=info


# ---- Web / Client (NEXT_PUBLIC_*) ----
# Public-facing API URL used by the frontend
NEXT_PUBLIC_API_URL=http://localhost:3000

# Skip env validation during builds (useful in Docker builds)
SKIP_ENV_VALIDATION=false
